{
  "name": "elec_vue_client",
  "version": "1.0.0",
  "description": "Electron 39 + Vue 3 + TypeScript 教学与模板工程，附带可复用信号分析组件库（IQ/频谱/时频/星座/眼图等 10 个组件）",
  "main": "./out/main/index.js",
  "author": "dowdyboy",
  "license": "MIT",
  "homepage": "https://github.com/dowdyboy/elec_vue_client",
  "repository": {
    "type": "git",
    "url": "https://github.com/dowdyboy/elec_vue_client.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "copy:feature": "node scripts/copy-feature.mjs",
    "copy:signal": "node scripts/copy-signal.mjs",
    "mock:remote": "node scripts/remote-signal-mock.mjs",
    "mock:gnuradio": "node scripts/gnuradio-mock-tcp.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:source-ipc && npm run test:source-preview && npm run test:signal-pages && npm run test:signal-demo && npm run test:sections",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:signal": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.signal.json && node scripts/write-signal-package.mjs",
    "check:signal": "node scripts/check-signal-package.mjs",
    "playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "test:visual": "npm run build:playground && node scripts/visual-run-all.mjs",
    "test:visual:update": "npm run build:playground && node scripts/visual-run-all.mjs --update",
    "test:smoke": "npm run build:playground && node scripts/run-smoke.mjs",
    "test:source": "npm run build && node scripts/run-source-ui-smoke.mjs",
    "test:source-ipc": "node scripts/run-source-ipc-e2e.mjs",
    "test:source-preview": "npm run build && node scripts/run-source-preview-e2e.mjs",
    "test:signal-pages": "npm run build && node scripts/run-signal-pages-e2e.mjs",
    "test:signal-demo": "npm run build && node scripts/run-signal-demo-e2e.mjs",
    "test:gnuradio": "npm run build && node scripts/run-gnuradio-e2e.mjs",
    "test:local-gnuradio": "npm run build && node scripts/run-local-gnuradio-e2e.mjs",
    "test:raw-playback": "npm run build && node scripts/run-raw-playback-e2e.mjs",
    "test:gnuradio-split": "npm run build && node scripts/run-gnuradio-split-e2e.mjs",
    "test:gnuradio-dualch": "npm run build && node scripts/run-gnuradio-dualch-e2e.mjs",
    "test:dual-sim": "npm run build && node scripts/run-dual-sim-e2e.mjs",
    "test:gnuradio-perf": "npm run build && node scripts/run-gnuradio-perf-e2e.mjs",
    "test:sections": "npm run build && node scripts/run-section-sweep.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "axios": "^1.21.1",
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "naive-ui": "^2.45.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.6.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^15.11.7",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
